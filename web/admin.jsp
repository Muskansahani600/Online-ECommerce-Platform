<%@ page import="java.sql.*,java.util.*,com.ecommerce.OnlineECommercePlatform.*" %><% ResultSet us=(ResultSet)request.getAttribute("users");ResultSet os=(ResultSet)request.getAttribute("orders");List<Product> ps=(List<Product>)request.getAttribute("products"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administration | Online E-Commerce Platform</title><link rel="stylesheet" href="style.css"></head><body><nav><a class="logo" href="dashboard"><span class="logo-mark">E</span><b>Online E-Commerce <span style="color:#315df4">Platform</span></b></a><span><a href="dashboard">Dashboard</a><a href="products">Products</a><a href="orders">Orders</a><a href="logout">Sign out ↗</a></span></nav><div class="shell"><aside class="sidebar"><div class="side-label">WORKSPACE</div><a class="side-link" href="dashboard">◫ &nbsp; Overview</a><a class="side-link" href="products">▦ &nbsp; Products</a><a class="side-link" href="orders">▤ &nbsp; Orders</a><a class="side-link" href="admin">⚙ &nbsp; Administration</a><div class="side-bottom"><a class="side-link" href="logout">↗ &nbsp; Sign out</a></div></aside><main><div class="page-head"><div><span class="eyebrow">WORKSPACE / ADMINISTRATION</span><h1>Administration center</h1><p class="muted">Oversee users, products and order operations in one place.</p></div><span class="badge">● ADMIN ACCESS</span></div><div class="cards"><div class="stat"><div class="stat-icon">👥</div><small>USER DIRECTORY</small><b>Accounts</b><small>Manage platform access</small></div><div class="stat"><div class="stat-icon">📦</div><small>PRODUCT CATALOG</small><b><%=ps==null?0:ps.size()%> products</b><small>Review live inventory</small></div><div class="stat"><div class="stat-icon">🚚</div><small>ORDER OPERATIONS</small><b>Fulfillment</b><small>Track and update status</small></div></div><div class="section-title"><h2>Create a new user</h2></div><div class="panel"><form class="formrow" method="post"><input type="hidden" name="action" value="createUser"><input name="name" placeholder="Full name" required><input name="email" type="email" placeholder="Email address" required><input name="password" type="password" placeholder="Password" required><select name="role"><option>BUYER</option><option>SELLER</option><option>ADMIN</option></select><button>Create user →</button></form></div><div class="section-title"><h2>Registered users</h2></div><div class="table-scroll"><table><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr><%if(us!=null)while(us.next()){%><tr><td>#<%=us.getInt("id")%></td><td><%=us.getString("name")%></td><td><%=us.getString("email")%></td><td><span class="badge"><%=us.getString("role")%></span></td><td><form method="post"><input type="hidden" name="action" value="deleteUser"><input type="hidden" name="id" value="<%=us.getInt("id")%>"><button class="danger" onclick="return confirm('Delete this user?')">Delete</button></form></td></tr><%}%></table></div><div class="section-title"><h2>Product catalog</h2></div><div class="table-scroll"><table><tr><th>ID</th><th>Product name</th><th>Price</th><th>Available stock</th></tr><%if(ps!=null)for(Product p:ps){%><tr><td>#<%=p.getId()%></td><td><%=p.getName()%></td><td>₹<%=String.format("%,.2f",p.getPrice())%></td><td><%=p.getStock()%></td></tr><%}%></table></div><div class="section-title"><h2>Orders &amp; fulfillment</h2></div><div class="table-scroll"><table><tr><th>Order ID</th><th>Buyer</th><th>Product</th><th>Total</th><th>Status</th><th>Update</th></tr><%if(os!=null)while(os.next()){%><tr><td>#<%=os.getInt("id")%></td><td><%=os.getString("buyer")%></td><td><%=os.getString("product")%></td><td>₹<%=String.format("%,.2f",os.getDouble("total"))%></td><td><span class="badge"><%=os.getString("status")%></span></td><td><form method="post"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="<%=os.getInt("id")%>"><select name="status"><option>PROCESSING</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button>Update</button></form></td></tr><%}%></table></div></main></div></body></html>