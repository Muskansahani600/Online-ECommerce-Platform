<%@ page import="com.ecommerce.OnlineECommercePlatform.User" %><% User u=(User)session.getAttribute("user"); if(u==null){response.sendRedirect("index.jsp");return;} %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard | Online E-Commerce Platform</title><link rel="stylesheet" href="style.css"></head><body><nav><a class="logo" href="dashboard"><span class="logo-mark">E</span><b>Online E-Commerce <span style="color:#315df4">Platform</span></b></a><span><a href="dashboard">Dashboard</a><a href="products">Products</a><a href="orders">Orders</a><a href="logout">Sign out ↗</a></span></nav><div class="shell"><aside class="sidebar"><div class="side-label">WORKSPACE</div><a class="side-link" href="dashboard">◫ &nbsp; Overview</a><a class="side-link" href="products">▦ &nbsp; Products</a><a class="side-link" href="orders">▤ &nbsp; Orders</a><a class="side-link" href="admin">⚙ &nbsp; Administration</a><div class="side-bottom"><a class="side-link" href="logout">↗ &nbsp; Sign out</a></div></aside><main><div class="page-head"><div><span class="eyebrow">YOUR WORKSPACE / OVERVIEW</span><h1>Welcome back, <%=u.getName()%> 👋</h1><p class="muted">Here's your <%=u.getRole().toLowerCase()%> workspace. Everything in one place.</p></div><span class="badge"><%=u.getRole()%> ACCOUNT</span></div><div class="hero"><span class="eyebrow" style="color:#b9ceff">ONLINE E-COMMERCE PLATFORM</span><h1><%=u.roleDescription()%></h1><p>Manage your daily activity with confidence, from browsing products to keeping operations on track.</p><a class="btn" href="products">Explore products →</a></div><div class="section-title"><h2>Quick access</h2><span class="muted">Your essential tools</span></div><div class="cards"><% if(u.getRole().equals("ADMIN")){ %><a class="card" href="admin"><span style="font-size:30px">⚙️</span><b>Administration</b><span>Manage users, review products and update orders.</span><span class="arrow">Open management →</span></a><% } %><% if(u.getRole().equals("SELLER")){ %><a class="card" href="products"><span style="font-size:30px">📦</span><b>Products &amp; inventory</b><span>Add listings and keep track of your available stock.</span><span class="arrow">Manage inventory →</span></a><a class="card" href="orders"><span style="font-size:30px">🚚</span><b>Orders</b><span>Review orders and follow customer fulfillment.</span><span class="arrow">View orders →</span></a><% } %><% if(u.getRole().equals("BUYER")){ %><a class="card" href="products"><span style="font-size:30px">🛍️</span><b>Explore products</b><span>Find your next favorite product and shop securely.</span><span class="arrow">Start shopping →</span></a><a class="card" href="orders"><span style="font-size:30px">📋</span><b>My orders</b><span>Keep track of your purchases and delivery status.</span><span class="arrow">Track orders →</span></a><% } %><a class="card" href="logout"><span style="font-size:30px">🔐</span><b>Account session</b><span>Finish your session safely when you're done.</span><span class="arrow">Sign out →</span></a></div></main></div></body></html>