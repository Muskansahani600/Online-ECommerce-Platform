<%@ page import="java.util.*,com.ecommerce.OnlineECommercePlatform.*" %><% User u=(User)session.getAttribute("user"); List<Product> ps=(List<Product>)request.getAttribute("products"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Products | Online E-Commerce Platform</title><link rel="stylesheet" href="style.css"></head><body><nav><a class="logo" href="dashboard"><span class="logo-mark">E</span><b>Online E-Commerce <span style="color:#315df4">Platform</span></b></a><span><a href="dashboard">Dashboard</a><a href="products">Products</a><a href="orders">Orders</a><a href="logout">Sign out ↗</a></span></nav><div class="shell"><aside class="sidebar"><div class="side-label">WORKSPACE</div><a class="side-link" href="dashboard">◫ &nbsp; Overview</a><a class="side-link" href="products">▦ &nbsp; Products</a><a class="side-link" href="orders">▤ &nbsp; Orders</a><a class="side-link" href="admin">⚙ &nbsp; Administration</a><div class="side-bottom"><a class="side-link" href="logout">↗ &nbsp; Sign out</a></div></aside><main><div class="page-head"><div><span class="eyebrow">CATALOG / PRODUCTS</span><h1><%=u!=null&&u.getRole().equals("SELLER")?"Your inventory":"Discover products"%></h1><p class="muted">Browse the latest listings and manage your shopping experience.</p></div><span class="badge"><%=ps==null?0:ps.size()%> PRODUCTS</span></div><%if(request.getParameter("error")!=null){%><div class="error">We couldn't complete that action. Please check the details and try again.</div><%}%><div class="hero"><span class="eyebrow" style="color:#b9ceff">CURATED FOR YOU</span><h1>Great products. Better experiences.</h1><p>Find everyday essentials, tech favorites and more—all in one easy-to-use store.</p></div><div class="section-title"><h2>Available products</h2><span class="muted">Browse our collection</span></div><div class="grid"><%if(ps!=null)for(Product p:ps){ String n=p.getName().toLowerCase();String emoji=n.contains("laptop")?"💻":n.contains("phone")?"📱":n.contains("headphone")?"🎧":n.contains("keyboard")?"⌨️":"📦";%><div class="product"><div class="product-art"><%=emoji%></div><div class="product-body"><h2><%=p.getName()%></h2><p><%=p.getDescription()%></p><div style="display:flex;align-items:center;justify-content:space-between;gap:8px"><span class="price">₹<%=String.format("%,.2f",p.getPrice())%></span><span class="stock"><%=p.getStock()>0?p.getStock()+" in stock":"Out of stock"%></span></div><%if(u!=null&&u.getRole().equals("BUYER")&&p.getStock()>0){%><form method="post" action="orders"><input type="hidden" name="productId" value="<%=p.getId()%>"><input aria-label="Quantity" name="quantity" type="number" value="1" min="1" max="<%=p.getStock()%>"><button>Buy now →</button></form><%}%></div></div><%}%></div><%if(u!=null&&u.getRole().equals("SELLER")){%><div class="section-title"><h2>Add a new product</h2></div><div class="panel"><form class="formrow" method="post" action="products"><input name="name" placeholder="Product name" required><input name="description" placeholder="Description"><input name="price" type="number" step=".01" min="0" placeholder="Price" required><input name="stock" type="number" min="0" placeholder="Stock" required><button>Add product →</button></form></div><%}%></main></div></body></html>