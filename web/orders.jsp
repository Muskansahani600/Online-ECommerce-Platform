<%@ page import="java.sql.*" %><% ResultSet rs=(ResultSet)request.getAttribute("orders"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Orders | Online E-Commerce Platform</title><link rel="stylesheet" href="style.css"></head><body><nav><a class="logo" href="dashboard"><span class="logo-mark">E</span><b>Online E-Commerce <span style="color:#315df4">Platform</span></b></a><span><a href="dashboard">Dashboard</a><a href="products">Products</a><a href="orders">Orders</a><a href="logout">Sign out ↗</a></span></nav><div class="shell"><aside class="sidebar"><div class="side-label">WORKSPACE</div><a class="side-link" href="dashboard">◫ &nbsp; Overview</a><a class="side-link" href="products">▦ &nbsp; Products</a><a class="side-link" href="orders">▤ &nbsp; Orders</a><a class="side-link" href="admin">⚙ &nbsp; Administration</a><div class="side-bottom"><a class="side-link" href="logout">↗ &nbsp; Sign out</a></div></aside><main><div class="page-head"><div><span class="eyebrow">COMMERCE / ORDERS</span><h1>Order history</h1><p class="muted">View purchases, order details and fulfillment status.</p></div><a class="btn outline-btn" href="products">← Continue shopping</a></div><div class="section-title"><h2>All orders</h2></div><div class="table-scroll"><table><tr><th>Order ID</th><th>Product</th><th>Quantity</th><th>Total</th><th>Status</th><th>Date</th></tr><%if(rs!=null)while(rs.next()){%><tr><td>#<%=rs.getInt("id")%></td><td><%=rs.getString("product")%></td><td><%=rs.getInt("quantity")%></td><td>₹<%=String.format("%,.2f",rs.getDouble("total"))%></td><td><span class="badge"><%=rs.getString("status")%></span></td><td><%=rs.getTimestamp("ordered_at")%></td></tr><%}%></table></div></main></div></body></html>